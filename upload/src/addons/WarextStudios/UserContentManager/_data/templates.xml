<?xml version="1.0" encoding="utf-8"?>
<templates>
  <template type="public" title="wrxt_ucm_user_content" version_id="1000100" version_string="0.10.0"><![CDATA[
<xf:title>{{ phrase('warext_ucm_page_title_x', {'username': $user.username}) }}</xf:title>
<xf:breadcrumb href="{{ link('members', $user) }}">{$user.username}</xf:breadcrumb>
<div class="block"><div class="block-container"><div class="block-body"><div class="block-row"><a class="button" href="{{ link('kullanici-icerikleri', $user) }}">Konular</a> <a class="button" href="{{ link('kullanici-kaynaklari', $user) }}">Kaynaklar</a> <a class="button" href="{{ link('kullanici-icerik-gecmisi', $user) }}">İşlem Geçmişi</a> <xf:if is="$canBulk"><a class="button" href="{{ link('kullanici-icerik-uyari', $user) }}">Uyarı Ver</a></xf:if></div></div></div></div>
<div class="block"><div class="block-container"><h2 class="block-header">{{ phrase('warext_ucm_summary') }}</h2><div class="block-body"><div class="block-row"><div class="pairJustifier"><dl class="pairs pairs--rows"><dt>{{ phrase('warext_ucm_total_threads') }}</dt><dd>{$stats.total|number}</dd></dl><dl class="pairs pairs--rows"><dt>{{ phrase('warext_ucm_visible_threads') }}</dt><dd>{$stats.visible|number}</dd></dl><dl class="pairs pairs--rows"><dt>{{ phrase('warext_ucm_deleted_threads') }}</dt><dd>{$stats.deleted|number}</dd></dl><dl class="pairs pairs--rows"><dt>{{ phrase('warext_ucm_moderated_threads') }}</dt><dd>{$stats.moderated|number}</dd></dl><dl class="pairs pairs--rows"><dt>{{ phrase('warext_ucm_locked_threads') }}</dt><dd>{$stats.locked|number}</dd></dl></div></div></div></div></div>
<xf:form action="{{ link('kullanici-icerikleri', $user) }}" method="get" class="block"><div class="block-container"><h2 class="block-header">{{ phrase('warext_ucm_filters') }}</h2><div class="block-body"><xf:selectrow name="category_id" value="{$filters.category_id}" label="{{ phrase('warext_ucm_category') }}"><xf:option value="">Tümü</xf:option><xf:foreach loop="$categoryChoices" key="$id" value="$title"><xf:option value="{$id}">{$title}</xf:option></xf:foreach></xf:selectrow><xf:selectrow name="node_id" value="{$filters.node_id}" label="{{ phrase('warext_ucm_forum_subcategory') }}"><xf:option value="">Tümü</xf:option><xf:foreach loop="$forumChoices" key="$id" value="$title"><xf:option value="{$id}">{$title}</xf:option></xf:foreach></xf:selectrow><xf:selectrow name="state" value="{$filters.state}" label="Durum"><xf:option value="">Tümü</xf:option><xf:option value="visible">Görünür</xf:option><xf:option value="deleted">Silinmiş</xf:option><xf:option value="moderated">Onay bekleyen</xf:option></xf:selectrow><xf:selectrow name="locked" value="{$filters.locked}" label="Kilit durumu"><xf:option value="">Tümü</xf:option><xf:option value="open">Açık</xf:option><xf:option value="locked">Kilitli</xf:option></xf:selectrow><xf:selectrow name="prefix_id" value="{$filters.prefix_id}" label="Önek"><xf:option value="0">Tümü</xf:option><xf:option value="-1">Öneksiz</xf:option><xf:foreach loop="$prefixes" value="$prefix"><xf:option value="{$prefix.prefix_id}">{$prefix.title}</xf:option></xf:foreach></xf:selectrow><xf:textboxrow name="title" value="{$filters.title}" label="Başlıkta geçen ifade" /><xf:dateinputrow name="date_from" value="{$filters.date_from}" label="Başlangıç tarihi" /><xf:dateinputrow name="date_to" value="{$filters.date_to}" label="Bitiş tarihi" /><xf:numberboxrow name="min_replies" value="{$filters.min_replies}" min="0" label="Minimum cevap" /><xf:numberboxrow name="max_replies" value="{$filters.max_replies}" min="0" label="Maksimum cevap" /><xf:numberboxrow name="min_views" value="{$filters.min_views}" min="0" label="Minimum görüntülenme" /><xf:numberboxrow name="max_views" value="{$filters.max_views}" min="0" label="Maksimum görüntülenme" /></div><xf:submitrow submit="Filtreleri Uygula" /></div></xf:form>
<xf:if is="$canBulk"><xf:form action="{{ link('kullanici-icerikleri/bulk', $user, $filterParams) }}" method="post"><input type="hidden" name="source_page" value="{$page}" /><div class="block"><div class="block-container"><h2 class="block-header">Toplu İşlemler</h2><div class="block-body"><xf:selectrow name="selection_scope" value="selected" label="Kapsam"><xf:option value="selected">İşaretlediğim konular</xf:option><xf:option value="page">Bu sayfa</xf:option><xf:option value="category">Seçili kategori / forum</xf:option><xf:option value="filter">Tüm filtre sonucu</xf:option></xf:selectrow><xf:selectrow name="bulk_action" label="İşlem"><xf:option value="">İşlem seçin</xf:option><xf:option value="move">Taşı</xf:option><xf:option value="soft_delete">Sil</xf:option><xf:if is="$canHardDelete"><xf:option value="hard_delete">Kalıcı sil</xf:option></xf:if><xf:option value="restore">Geri getir</xf:option><xf:option value="lock">Kilitle</xf:option><xf:option value="unlock">Kilidi aç</xf:option><xf:option value="stick">Sabitle</xf:option><xf:option value="unstick">Sabitlemeyi kaldır</xf:option><xf:option value="approve">Onayla</xf:option><xf:option value="unapprove">Onayı kaldır</xf:option><xf:option value="prefix">Önek değiştir</xf:option><xf:option value="title_prepend">Başlığın başına ekle</xf:option><xf:option value="title_append">Başlığın sonuna ekle</xf:option><xf:option value="title_replace">Başlıkta değiştir</xf:option></xf:selectrow><xf:selectrow name="target_node_id" label="Hedef forum"><xf:option value="0">Forum seçin</xf:option><xf:foreach loop="$forumChoices" key="$id" value="$title"><xf:option value="{$id}">{$title}</xf:option></xf:foreach></xf:selectrow><xf:selectrow name="target_prefix_id" label="Yeni önek"><xf:option value="0">Öneki kaldır</xf:option><xf:foreach loop="$prefixes" value="$prefix"><xf:option value="{$prefix.prefix_id}">{$prefix.title}</xf:option></xf:foreach></xf:selectrow><xf:textboxrow name="reason" label="İşlem nedeni" /><xf:textboxrow name="title_value" label="Başlığa eklenecek metin" /><xf:textboxrow name="title_search" label="Aranacak metin" /><xf:textboxrow name="title_replace" label="Yerine yazılacak metin" /><xf:if is="$canHardDelete"><xf:checkboxrow><xf:option name="confirm_hard_delete" value="1">Kalıcı silmenin geri alınamayacağını kabul ediyorum</xf:option></xf:checkboxrow></xf:if></div><xf:submitrow submit="Toplu İşlemi Uygula" /></div></div><xf:foreach loop="$groups" value="$group"><div class="block"><div class="block-container"><h3 class="block-header"><xf:if is="$group.forum"><a href="{{ link('forums', $group.forum) }}">{$group.forum.title}</a><xf:else />Kategori bulunamadı</xf:if></h3><div class="structItemContainer"><xf:foreach loop="$group.threads" value="$thread"><div class="structItem structItem--thread"><div class="structItem-cell structItem-cell--icon"><input type="checkbox" name="thread_ids[]" value="{$thread.thread_id}" /></div><div class="structItem-cell structItem-cell--main"><div class="structItem-title"><xf:if is="$thread.prefix_id">{{ prefix('thread', $thread.prefix_id, 'html', '') }}</xf:if> <a href="{{ link('threads', $thread) }}">{$thread.title}</a></div><div class="structItem-minor"><xf:date time="$thread.last_post_date" /></div></div><div class="structItem-cell structItem-cell--meta"><dl class="pairs pairs--justified"><dt>Cevap</dt><dd>{$thread.reply_count|number}</dd></dl><dl class="pairs pairs--justified"><dt>Görüntülenme</dt><dd>{$thread.view_count|number}</dd></dl></div></div></xf:foreach></div></div></div></xf:foreach></xf:form><xf:else /><div class="block"><div class="block-container"><div class="structItemContainer"><xf:foreach loop="$threads" value="$thread"><div class="structItem"><div class="structItem-cell structItem-cell--main"><a href="{{ link('threads', $thread) }}">{$thread.title}</a></div></div></xf:foreach></div></div></div></xf:if><div class="block-outer"><xf:pagenav page="{$page}" perpage="{$perPage}" total="{$total}" link="kullanici-icerikleri" data="{$user}" params="{$filterParams}" wrapperclass="block-outer-main" /></div>
]]></template>
  <template type="public" title="wrxt_ucm_resource_content" version_id="1000100" version_string="0.10.0"><![CDATA[
<xf:title>{$user.username} | Kaynak Yönetimi</xf:title><xf:breadcrumb href="{{ link('members', $user) }}">{$user.username}</xf:breadcrumb><div class="block"><div class="block-container"><div class="block-body"><div class="block-row"><a class="button" href="{{ link('kullanici-icerikleri', $user) }}">Konular</a> <a class="button" href="{{ link('kullanici-kaynaklari', $user) }}">Kaynaklar</a> <a class="button" href="{{ link('kullanici-icerik-gecmisi', $user) }}">İşlem Geçmişi</a></div></div></div></div><xf:form action="{{ link('kullanici-kaynaklari', $user) }}" method="get" class="block"><div class="block-container"><h2 class="block-header">Kaynak Filtreleri</h2><div class="block-body"><xf:selectrow name="category_id" value="{$filters.category_id}" label="Kategori"><xf:option value="0">Tümü</xf:option><xf:foreach loop="$categoryChoices" key="$id" value="$title"><xf:option value="{$id}">{$title}</xf:option></xf:foreach></xf:selectrow><xf:selectrow name="state" value="{$filters.state}" label="Durum"><xf:option value="">Tümü</xf:option><xf:option value="visible">Görünür</xf:option><xf:option value="deleted">Silinmiş</xf:option><xf:option value="moderated">Onay bekleyen</xf:option></xf:selectrow><xf:textboxrow name="title" value="{$filters.title}" label="Başlıkta geçen ifade" /></div><xf:submitrow submit="Filtrele" /></div></xf:form><xf:if is="$canBulk"><xf:form action="{{ link('kullanici-kaynaklari/bulk', $user, $filterParams) }}" method="post"><input type="hidden" name="source_page" value="{$page}" /><div class="block"><div class="block-container"><h2 class="block-header">Kaynak Toplu İşlemleri</h2><div class="block-body"><xf:selectrow name="selection_scope" value="selected" label="Kapsam"><xf:option value="selected">İşaretlenenler</xf:option><xf:option value="page">Bu sayfa</xf:option><xf:option value="filter">Tüm filtre sonucu</xf:option></xf:selectrow><xf:selectrow name="bulk_action" label="İşlem"><xf:option value="move">Kategori değiştir</xf:option><xf:option value="soft_delete">Sil</xf:option><xf:if is="$canHardDelete"><xf:option value="hard_delete">Kalıcı sil</xf:option></xf:if><xf:option value="restore">Geri getir</xf:option><xf:option value="approve">Onayla</xf:option><xf:option value="unapprove">Onayı kaldır</xf:option><xf:option value="prefix">Önek değiştir</xf:option><xf:option value="title_prepend">Başlığın başına ekle</xf:option><xf:option value="title_append">Başlığın sonuna ekle</xf:option><xf:option value="title_replace">Başlıkta değiştir</xf:option></xf:selectrow><xf:selectrow name="target_category_id" label="Hedef kategori"><xf:option value="0">Kategori seçin</xf:option><xf:foreach loop="$categoryChoices" key="$id" value="$title"><xf:option value="{$id}">{$title}</xf:option></xf:foreach></xf:selectrow><xf:numberboxrow name="target_prefix_id" min="0" label="Yeni önek ID" /><xf:textboxrow name="reason" label="Neden" /><xf:textboxrow name="title_value" label="Başlığa eklenecek metin" /><xf:textboxrow name="title_search" label="Aranacak metin" /><xf:textboxrow name="title_replace" label="Yerine yazılacak metin" /><xf:if is="$canHardDelete"><xf:checkboxrow><xf:option name="confirm_hard_delete" value="1">Kalıcı silmenin geri alınamayacağını kabul ediyorum</xf:option></xf:checkboxrow></xf:if></div><xf:submitrow submit="Uygula" /></div></div><div class="block"><div class="block-container"><div class="structItemContainer"><xf:foreach loop="$resources" value="$resource"><div class="structItem"><div class="structItem-cell structItem-cell--icon"><input type="checkbox" name="resource_ids[]" value="{$resource.resource_id}" /></div><div class="structItem-cell structItem-cell--main"><div class="structItem-title"><a href="{{ link('resources', $resource) }}">{$resource.title}</a></div><div class="structItem-minor"><xf:if is="$resource.Category">{$resource.Category.title} · </xf:if><xf:date time="$resource.last_update" /> · {$resource.resource_state}</div></div><div class="structItem-cell structItem-cell--meta"><dl class="pairs pairs--justified"><dt>İndirme</dt><dd>{$resource.download_count|number}</dd></dl><dl class="pairs pairs--justified"><dt>Görüntülenme</dt><dd>{$resource.view_count|number}</dd></dl></div></div></xf:foreach></div></div></div></xf:form><xf:else /><div class="block"><div class="block-container"><div class="structItemContainer"><xf:foreach loop="$resources" value="$resource"><div class="structItem"><div class="structItem-cell structItem-cell--main"><a href="{{ link('resources', $resource) }}">{$resource.title}</a></div></div></xf:foreach></div></div></div></xf:if><div class="block-outer"><xf:pagenav page="{$page}" perpage="{$perPage}" total="{$total}" link="kullanici-kaynaklari" data="{$user}" params="{$filterParams}" wrapperclass="block-outer-main" /></div>
]]></template>
  <template type="public" title="wrxt_ucm_user_warning" version_id="1000100" version_string="0.10.0"><![CDATA[
<xf:title>{$user.username} | Uyarı Ver</xf:title><xf:breadcrumb href="{{ link('members', $user) }}">{$user.username}</xf:breadcrumb><xf:form action="{{ link('kullanici-icerik-uyari/save', $user) }}" method="post" class="block"><div class="block-container"><h2 class="block-header">Birden Fazla İçeriğe Dayalı Tek Uyarı</h2><div class="block-body"><xf:selectrow name="warning_definition_id" label="Uyarı türü"><xf:foreach loop="$definitions" value="$definition"><xf:option value="{$definition.warning_definition_id}">{$definition.title} ({$definition.points} puan)</xf:option></xf:foreach></xf:selectrow><div class="block-row"><b>İlgili konular</b><xf:foreach loop="$threads" value="$thread"><div><label><input type="checkbox" name="thread_ids[]" value="{$thread.thread_id}" /> {$thread.title}</label></div></xf:foreach></div></div><xf:submitrow submit="Uyarıyı Oluştur" /></div></xf:form>
]]></template>
  <template type="public" title="wrxt_ucm_action_history" version_id="1000100" version_string="0.10.0"><![CDATA[
<xf:title>{$user.username} | İşlem Geçmişi</xf:title><xf:breadcrumb href="{{ link('members', $user) }}">{$user.username}</xf:breadcrumb><div class="block"><div class="block-container"><h2 class="block-header">Son 200 İşlem</h2><div class="block-body"><xf:foreach loop="$logs" value="$log"><div class="block-row"><b><xf:if is="$log.Actor">{$log.Actor.username}<xf:else />#{$log.actor_user_id}</xf:if></b> · {$log.content_type} #{$log.content_id} · {$log.action}<xf:if is="$log.reason"> · {$log.reason}</xf:if><div class="contentRow-minor"><xf:date time="$log.log_date" /></div></div></xf:foreach></div></div></div>
]]></template>
</templates>
